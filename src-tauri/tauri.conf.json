{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "idts video editor",
  "version": "0.1.0",
  "identifier": "com.idts.videoeditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "idts video editor",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "theme": "Dark",
        "backgroundColor": "#0D0E11",
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "fileAssociations": [
      {
        "ext": ["idts"],
        "name": "idts Video Editor Project",
        "description": "idts Video Editor Project File",
        "role": "Editor"
      }
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ]
  }
}